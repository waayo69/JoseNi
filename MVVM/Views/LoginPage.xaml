<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JoseNi.MVVM.ViewModels"
             x:Class="JoseNi.MVVM.Views.LoginPage"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False"
             Title="LoginPage">

    <!-- Set the BindingContext to LoginPageClass ViewModel -->
    <ContentPage.BindingContext>
        <vm:LoginPageClass/>
    </ContentPage.BindingContext>

    <VerticalStackLayout>
        <!-- App Logo -->
        <Image Source="logo.png" WidthRequest="150" HeightRequest="150" Margin="0,100,0,0"/>

        <!-- App Name (UnderSec) -->
        <HorizontalStackLayout HorizontalOptions="Center">
            <Label Text="    Under" FontSize="32" HorizontalOptions="Center" TextColor="Gray" BackgroundColor="AntiqueWhite" Margin="0,0,70,0"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout HorizontalOptions="Center">
            <Label Text="Sec" FontSize="32" HorizontalOptions="Center" TextColor="Gray" Margin="50,0,0,0"/>
        </HorizontalStackLayout>

        <!-- Carousel View for Slogans -->
        <CarouselView x:Name="Cview" Loop="True">
            <CarouselView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>No Filters</x:String>
                    <x:String>No Censorship</x:String>
                    <x:String>Just Pure Internet Culture</x:String>
                </x:Array>
            </CarouselView.ItemsSource>
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Label Text="{Binding}" FontSize="24" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- User Input Fields -->
        <VerticalStackLayout Padding="50" Spacing="5" Margin="0,140,0,0">
            <Entry Placeholder="Username" Text="{Binding Username, Mode=TwoWay}" TextColor="AntiqueWhite"/>

            <Grid>
                <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       IsPassword="{Binding IsPasswordHidden, Mode=TwoWay}"
                       Text="{Binding Password, Mode=TwoWay}"
                       TextColor="AntiqueWhite"
                       WidthRequest="250"/>
                <CheckBox IsChecked="{Binding IsPasswordHidden, Mode=TwoWay}" 
                          VerticalOptions="Center" 
                          HorizontalOptions="End"/>
            </Grid>
            <Button Text="Login" BackgroundColor="AntiqueWhite" TextColor="Black" Command="{Binding LoginCommand}"/>
            <Button Text="Loginn" Clicked="Button_Clicked" BackgroundColor="AntiqueWhite" TextColor="Black"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
