<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:JoseNi.MVVM.ViewModels"
             x:Class="JoseNi.MVVM.Views.HomePage"
             Title="HomePage">
    <ContentPage.BindingContext>
        <local:AccountViewModel/>
    </ContentPage.BindingContext>
    
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Image Source="oiia.gif"  IsAnimationPlaying="True"/>
        </HorizontalStackLayout>

        <Label Text="First Name:" TextColor="White" FontSize="Body" />
        <Label Text="{Binding FName}" TextColor="White"/>
        <Label Text="Last Name:" TextColor="White" FontSize="Body" />
        <Label Text="{Binding LName}" TextColor="White"/>
        <Label Text="Age:" TextColor="White" FontSize="Body" />
        <Label Text="{Binding Age}" TextColor="White"/>
        <Label Text="Date of Birth:" TextColor="White" FontSize="Body" />
        <Label Text="{Binding DoB, StringFormat='{}{0:MMMM dd, yyyy}'}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
        <Label Text="Gender:" TextColor="White" FontSize="Body" />
        <Label Text="{Binding Gender}" TextColor="White"/>
    </VerticalStackLayout>
</ContentPage>