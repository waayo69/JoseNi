<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JoseNi.MVVM.Views.SignUpPage1"
             xmlns:local="clr-namespace:JoseNi.MVVM.ViewModels"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False"
             Title="SignUpPage1">

    <ContentPage.BindingContext>
        <local:AccountViewModel/>
    </ContentPage.BindingContext>
    
    <VerticalStackLayout>
        <VerticalStackLayout>
            <Image Source="logo.png" WidthRequest="150" HeightRequest="150" Margin="0,100,0,0"/>

            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="    Under" FontSize="32" HorizontalOptions="Center" TextColor="Gray" BackgroundColor="AntiqueWhite" Margin="0,0,70,0"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Sec" FontSize="32" HorizontalOptions="Center" TextColor="Gray" Margin="50,0,0,0"/>
            </HorizontalStackLayout>
            <VerticalStackLayout>
                <Entry x:Name="regEmail" Text="{Binding Email}" Placeholder="Email" Margin="0,0,0,0"/>
                <Entry x:Name="regUserName" Text="{Binding Username}" Placeholder="Username"/>
                <Entry x:Name="regPass" Text="{Binding Password}" Placeholder="Password" IsPassword="True"/>
                <Button x:Name="btnCreateAcc" Command="{Binding RegisterButton}" Text="Register" BackgroundColor="AntiqueWhite" TextColor="Black" Margin="0,100,0,0"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>